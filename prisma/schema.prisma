// schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────
// MULTI-TENANT
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  email     String?
  phone     String?
  address      String?
  logo_url     String?
  groq_api_key String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  contracts         Contract[]
  contractTemplates ContractTemplate[]
  obras             Obra[]
  purchaseOrders    PurchaseOrder[]
  uploads           Upload[]
  auditLogs         AuditLog[]
}

model User {
  id         String   @id @default(uuid())
  company_id String
  name       String
  email      String
  password   String
  role       UserRole @default(OPERATOR)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company    @relation(fields: [company_id], references: [id])
  contracts Contract[]
  obras     Obra[]
  auditLogs AuditLog[]

  @@unique([email, company_id])
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

// ─────────────────────────────────────────────
// CONTRATOS
// ─────────────────────────────────────────────

model ContractTemplate {
  id           String       @id @default(uuid())
  company_id   String
  name         String
  type         ContractType
  description  String?
  html_content String       @db.Text
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company                 @relation(fields: [company_id], references: [id])
  fields    ContractTemplateField[]
  contracts Contract[]
}

model ContractTemplateField {
  id          String    @id @default(uuid())
  template_id String
  label       String
  field_key   String
  field_type  FieldType
  required    Boolean   @default(false)
  placeholder String?
  options     String[] // para selects/enums
  order       Int       @default(0)

  template ContractTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  EMAIL
  PHONE
  CPF
  CNPJ
  CURRENCY
  SELECT
  CHECKBOX
  SIGNATURE
  ADDRESS
}

enum ContractType {
  SERVICO
  TRABALHO
  OBRA
  LOCACAO
  COMPRA_VENDA
  PARCERIA
  CONFIDENCIALIDADE
  OUTROS
}

model Contract {
  id                  String         @id @default(uuid())
  company_id          String
  template_id         String?
  created_by          String
  title               String
  type                ContractType
  status              ContractStatus @default(DRAFT)
  related_party       String
  related_party_doc   String?
  related_party_email String?
  related_party_phone String?
  value               Decimal?       @db.Decimal(15, 2)
  start_date          DateTime?
  end_date            DateTime?
  html_content        String         @db.Text
  field_values        Json // valores preenchidos { campo: valor }
  signed_at           DateTime?
  archived_at         DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  company           Company           @relation(fields: [company_id], references: [id])
  template          ContractTemplate? @relation(fields: [template_id], references: [id])
  creator           User              @relation(fields: [created_by], references: [id])
  signatureRequests SignatureRequest[]
  obras             Obra[]
  uploads           Upload[]
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
  ARCHIVED
}

// ─────────────────────────────────────────────
// ASSINATURAS
// ─────────────────────────────────────────────

model SignatureRequest {
  id              String          @id @default(uuid())
  contract_id     String
  channel         SignatureChannel
  status          SignatureStatus @default(PENDING)
  recipient_name  String
  recipient_email String?
  recipient_phone String?
  token           String          @unique @default(uuid())
  expires_at      DateTime
  sent_at         DateTime?
  viewed_at       DateTime?
  signed_at       DateTime?
  ip_address      String?
  user_agent      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contract Contract @relation(fields: [contract_id], references: [id])
}

enum SignatureChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum SignatureStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────────
// OBRAS
// ─────────────────────────────────────────────

model Obra {
  id             String     @id @default(uuid())
  company_id     String
  contract_id    String?
  created_by     String
  name           String
  description    String?
  address        String?
  status         ObraStatus @default(PLANNING)
  budget         Decimal?   @db.Decimal(15, 2)
  actual_cost    Decimal    @default(0) @db.Decimal(15, 2)
  start_date     DateTime?
  end_date       DateTime?
  completion_pct Int        @default(0)
  responsible    String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company        Company         @relation(fields: [company_id], references: [id])
  contract       Contract?       @relation(fields: [contract_id], references: [id])
  creator        User            @relation(fields: [created_by], references: [id])
  steps          ObraStep[]
  vistorias      ObraVistoria[]
  custos         ObraCusto[]
  purchaseOrders PurchaseOrder[]
  uploads        Upload[]
}

enum ObraStatus {
  PLANNING
  PENDING_SIGNATURE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ObraStep {
  id           String     @id @default(uuid())
  obra_id      String
  title        String
  description  String?
  phase        ObraPhase
  status       StepStatus @default(PENDING)
  order        Int
  due_date     DateTime?
  completed_at DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)
}

enum ObraPhase {
  PLANEJAMENTO
  PRE_OBRA
  FUNDACAO
  ALVENARIA
  INSTALACOES
  ACABAMENTO
  ENTREGA
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}

model ObraVistoria {
  id          String       @id @default(uuid())
  obra_id     String
  type        VistoriaType
  date        DateTime
  inspector   String
  description String?      @db.Text
  conditions  Json?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  obra    Obra     @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  uploads Upload[]
}

enum VistoriaType {
  INICIAL
  PARCIAL
  FINAL
}

model ObraCusto {
  id             String        @id @default(uuid())
  obra_id        String
  category       CostCategory
  description    String
  supplier       String?
  value          Decimal       @db.Decimal(15, 2)
  date           DateTime
  invoice_no     String?
  payment_status PaymentStatus @default(PENDING)
  paid_at        DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  obra    Obra     @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  uploads Upload[]
}

enum CostCategory {
  MATERIAL
  MAO_DE_OBRA
  EQUIPAMENTO
  SERVICO_TERCEIRO
  LICENCA_TAXA
  TRANSPORTE
  OUTROS
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────────
// ORDENS DE COMPRA
// ─────────────────────────────────────────────

model PurchaseOrder {
  id             String   @id @default(uuid())
  company_id     String
  obra_id        String?
  number         String
  title          String
  supplier       String
  supplier_cnpj  String?
  payer_cnpj     String
  status         POStatus @default(DRAFT)
  items          Json // [{ description, qty, unit, unit_price, total }]
  subtotal       Decimal  @db.Decimal(15, 2)
  taxes          Decimal  @default(0) @db.Decimal(15, 2)
  discount       Decimal  @default(0) @db.Decimal(15, 2)
  total          Decimal  @db.Decimal(15, 2)
  due_date       DateTime?
  delivery_date  DateTime?
  notes          String?
  approved_by    String?
  approved_at    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company  @relation(fields: [company_id], references: [id])
  obra    Obra?    @relation(fields: [obra_id], references: [id])
  uploads Upload[]

  @@unique([company_id, number])
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_SUPPLIER
  PARTIAL_DELIVERY
  DELIVERED
  CANCELLED
}

// ─────────────────────────────────────────────
// UPLOADS & AUDITORIA
// ─────────────────────────────────────────────

model Upload {
  id            String       @id @default(uuid())
  company_id    String
  entity_type   UploadEntity
  entity_id     String
  filename      String
  original_name String
  mime_type     String
  size          Int
  url           String
  uploaded_by   String?
  createdAt     DateTime     @default(now())

  company      Company        @relation(fields: [company_id], references: [id])
  // Polymorphic relations via entity_type + entity_id
  contract     Contract?      @relation(fields: [entity_id], references: [id], map: "Upload_contract_fkey")
  obra         Obra?          @relation(fields: [entity_id], references: [id], map: "Upload_obra_fkey")
  vistoria     ObraVistoria?  @relation(fields: [entity_id], references: [id], map: "Upload_vistoria_fkey")
  custo        ObraCusto?     @relation(fields: [entity_id], references: [id], map: "Upload_custo_fkey")
  po           PurchaseOrder? @relation(fields: [entity_id], references: [id], map: "Upload_po_fkey")
}

enum UploadEntity {
  CONTRACT
  OBRA
  VISTORIA
  CUSTO
  PURCHASE_ORDER
  COMPANY
}

model AuditLog {
  id          String   @id @default(uuid())
  company_id  String
  user_id     String?
  entity_type String
  entity_id   String
  action      String
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])
  user    User?   @relation(fields: [user_id], references: [id])
}
